HOST=127.0.0.1
PORT=8000
DEBUG=false
CELL_TITAN_ENV=development
SENSOR_ID=civwatch-titan-local
EVIDENCE_DIR=./data/evidence
# Ed25519 evidence signing (schema v2). Keep the key outside EVIDENCE_DIR, mode 0600.
EVIDENCE_SIGNING=true
EVIDENCE_SIGNING_KEY=./data/keys/evidence_ed25519.pem
# After rotating the key, list previous public keys (base64) so old records still verify.
EVIDENCE_TRUSTED_PUBKEYS=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TITAN_API_TOKEN=
REQUIRE_AUTH=false
ALLOW_UNAUTHENTICATED_LOOPBACK=true
ADB_ENABLED=true
RATE_LIMIT_PER_MIN=120
MAX_BODY_BYTES=65536
