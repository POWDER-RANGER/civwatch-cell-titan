# Default bind is loopback. Only set 0.0.0.0 when TITAN_API_TOKEN is set + TLS/VPN in front.
HOST=127.0.0.1
PORT=8000
DEBUG=true
CELL_TITAN_ENV=development
SENSOR_ID=civwatch-titan-local
EVIDENCE_DIR=./data/evidence
CORS_ORIGINS=*

# Auth (required for any non-loopback or production use)
TITAN_API_TOKEN=
REQUIRE_AUTH=false
ALLOW_UNAUTHENTICATED_LOOPBACK=true

# ADB capture is privileged — off by default
ADB_ENABLED=false

AUTO_DEMO=false
DEMO_INTERVAL_SEC=15
RATE_LIMIT_PER_MIN=120
MAX_BODY_BYTES=65536
OPERATOR_CONTACT=
